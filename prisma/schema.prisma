generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id              String   @id(map: "accounts_pkey") @default(uuid())
  displayName     String?
  accountType     String   @default("individual")
  displayImage    String?
  status          String?
  isVerified      Boolean  @default(false)
  details         Json?
  createdAt       DateTime @default(now())
  linkedAccountId String?  @map("linked_account_id")

  brandProfile            AccountTypeBrand?
  individualProfile       AccountTypeIndividual?
  appConnections          ApplicationConnection[]
  authMethods             AuthnMethod[]
  sessions                AuthnSession[]
  contacts                Contact[]
  neupIds                 NeupId[]
  notifications           Notification[]
  portfolioMembers        PortfolioMember[]
  familyMembers           FamilyMember[]
  verificationActions     Verification[]            @relation("VerificationDoneBy")
  authzOwnedGrants        AuthzAccountAccessGrant[] @relation("AuthzGrantOwner")
  authzTargetGrants       AuthzAccountAccessGrant[] @relation("AuthzGrantTarget")
  authzAssetsAccessGrants AuthzAssetsAccessGrant[]
  authzAppOwnedGrants     AuthzAppAccessGrant[]     @relation("AuthzAppGrantOwner")
  authzAppTargetGrants    AuthzAppAccessGrant[]     @relation("AuthzAppGrantTarget")
  memberAccesses          MemberAccess[]
  ownedMembers            Member[]                  @relation("MemberOwner")
  targetAccountMembers    Member[]                  @relation("MemberTargetAccount")
  permits                 Permit[]
  permitTargets           Permit[]                  @relation("PermitTarget")
  parentOwnerships        AccountOwnership[]        @relation("ChildAccount")
  childOwnerships         AccountOwnership[]        @relation("ParentAccount")
  linkedAccount           Account?                  @relation("LinkedAccount", fields: [linkedAccountId], references: [id])
  linkedFrom              Account[]                 @relation("LinkedAccount")

  receivedRequests Request[]      @relation("ReceivedRequests")
  sentRequests     Request[]      @relation("SentRequests")
  errorLogs        SystemError[]
  verifications    Verification[]

  @@map("account")
}

model AccountTypeIndividual {
  accountId          String    @id @unique(map: "account_type__individual_accountId_key")
  firstName          String?
  middleName         String?
  lastName           String?
  dateOfBirth        DateTime?
  countryOfResidence String?
  details            Json?
  roleId             String?   @map("roleId")
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "account_type__individual_accountId_fkey")

  @@map("account_meta__individual")
}

model AccountTypeBrand {
  accountId     String  @id @unique(map: "account_type__brand_accountId_key")
  brandName     String?
  isLegalEntity Boolean @default(false)
  originCountry String?
  details       Json?
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "account_type__brand_accountId_fkey")

  @@map("account_meta__brand")
}

model SystemConfig {
  key       String   @id
  data      Json
  updatedAt DateTime @default(now()) @updatedAt

  @@map("system_config")
}

model AuthnRequest {
  id        String   @id(map: "auth_requests_pkey") @default(uuid())
  type      String
  status    String   @default("pending")
  data      Json     @default("{}")
  accountId String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("authn_request")
}

model Activity {
  id              String   @id(map: "activity_logs_pkey") @default(uuid())
  targetAccountId String   @map("target_account_id")
  actorAccountId  String   @map("actor_account_id")
  action          String
  status          String
  ip              String
  timestamp       DateTime @default(now())
  geolocation     String?

  @@map("activity")
}

model Notification {
  id          String    @id(map: "notifications_pkey") @default(uuid())
  accountId   String    @map("account_id")
  action      String?
  title       String?
  message     String?
  type        String    @default("info")
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  deletableOn DateTime? @map("deletable_on")
  persistence String?
  detail      Json?
  account     Account   @relation(fields: [accountId], references: [id], map: "notifications_accountId_fkey")

  @@map("notification")
}

model Request {
  id          String   @id(map: "requests_pkey") @default(uuid())
  senderId    String
  recipientId String   @map("recipient_id")
  status      String   @default("pending")
  action      String
  type        String?
  data        Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  recipient   Account  @relation("ReceivedRequests", fields: [recipientId], references: [id], map: "requests_recipientId_fkey")
  sender      Account  @relation("SentRequests", fields: [senderId], references: [id], map: "requests_senderId_fkey")

  @@map("request")
}

model Family {
  id        String         @id @default(uuid())
  createdBy String         @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  members   FamilyMember[]

  @@map("family")
}

model FamilyMember {
  id       String @id @default(uuid())
  familyId String @map("family_id")
  memberId String @map("member_id")
  role     String @default("member")

  family Family  @relation(fields: [familyId], references: [id], map: "family_member_family_id_fkey")
  member Account @relation(fields: [memberId], references: [id], map: "family_member_member_id_fkey")

  @@unique([familyId, memberId], map: "family_member_family_member_key")
  @@map("family_member")
}

model Verification {
  id         String   @id(map: "verification_pkey") @default(uuid())
  accountId  String   @map("account_id")
  status     String   @default("pending")
  reason     String?
  category   String?
  doneBy     String?  @map("done_by")
  doneAt     DateTime @default(now()) @map("done_at")
  previously String?
  createdAt  DateTime @default(now()) @map("created_at")

  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "verification_account_id_fkey")
  doneByAccount Account? @relation("VerificationDoneBy", fields: [doneBy], references: [id], map: "verification_done_by_fkey")

  @@map("verification")
}

model Contact {
  id          String  @id(map: "contacts_pkey") @default(uuid())
  accountId   String
  contactType String
  value       String
  account     Account @relation(fields: [accountId], references: [id], map: "contacts_accountId_fkey")

  @@map("contact")
}

model NeupId {
  id        String   @id(map: "neup_ids_pkey")
  accountId String
  neupId    String   @unique(map: "neupid_neupid_key") @map("neupId")
  isPrimary Boolean  @default(false)
  dateAdded DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], map: "neup_ids_accountId_fkey")

  @@map("neupid")
}

model AuthnMethod {
  accountId String
  value     String
  id        String  @id @default(uuid())
  type      String
  order     String
  status    String
  detail    Json?
  account   Account @relation(fields: [accountId], references: [id], map: "passwords_accountId_fkey")

  @@unique([accountId, type, order])
  @@index([accountId])
  @@map("authn_method")
}

model AuthnSession {
  id           String    @id(map: "sessions_pkey") @default(uuid())
  accountId    String
  key          String?
  ipAddress    String
  userAgent    String
  validTill    DateTime?
  lastLoggedIn DateTime
  loginType    String
  geolocation  String?
  deviceType   String?
  account      Account   @relation(fields: [accountId], references: [id], map: "sessions_accountId_fkey")

  @@map("authn_session")
}

model SystemError {
  id          String   @id(map: "error_logs_pkey") @default(uuid())
  message     String
  context     String
  timestamp   DateTime @default(now())
  accountId   String?
  geolocation String?
  ipAddress   String?
  account     Account? @relation(fields: [accountId], references: [id], map: "error_logs_accountId_fkey")

  @@map("system_error")
}

model ApplicationProvider {
  id           String        @id @default(uuid())
  providerName String        @map("provider_name")
  providerSite String        @map("provider_site")
  secretHash   String        @map("secret_hash")
  applications Application[]

  @@map("application_provider")
}

model Application {
  id                       String                    @id(map: "applications_pkey")
  name                     String
  description              String?
  icon                     String?
  website                  String?
  appSecret                String?                   @map("app_secret")
  createdAt                DateTime                  @default(now()) @map("created_at")
  endpoints                Json?
  status                   String                    @default("development")
  isInternal               Boolean                   @default(false) @map("is_internal")
  responseFields           String[]                  @default([]) @map("response_fields")
  tokenFields              String[]                  @default([]) @map("token_fields")
  details                  Json?
  party                    Int                       @default(1)
  providerId               String?                   @map("provider_id")
  provider                 ApplicationProvider?      @relation(fields: [providerId], references: [id], map: "application_provider_id_fkey")
  connections              ApplicationConnection[]
  bridge                   ApplicationBridge[]
  policies                 ApplicationPolicy[]
  authzPermissions        AuthzPermission[]
  authzRoles               AuthzRole[]
  authzAccountAccessGrants AuthzAccountAccessGrant[]
  authzAppAccessGrants     AuthzAppAccessGrant[]
  identities               Identity[]

  @@map("application")
}

model Portfolio {
  id                       String                    @id @default(uuid())
  name                     String
  description              String?
  dateCreated              DateTime                  @default(now())
  assets                   Asset[]
  members                  PortfolioMember[]
  targetPortfolioMembers   Member[]                  @relation("MemberTargetPortfolio")
  authzAccountAccessGrants AuthzAccountAccessGrant[]
  authzAssetsAccessGrants  AuthzAssetsAccessGrant[]
  authzAppAccessGrants     AuthzAppAccessGrant[]

  @@map("portfolio")
}

model Asset {
  id                      String                   @id(map: "portfolio_assets_pkey") @default(uuid())
  portfolioId             String
  assetType               String
  assetId                 String
  details                 Json?
  portfolio               Portfolio                @relation(fields: [portfolioId], references: [id], onDelete: Cascade, map: "portfolio_assets_portfolioId_fkey")
  authzAssetsAccessGrants AuthzAssetsAccessGrant[]

  @@index([assetType, assetId], map: "portfolio_assets_assetType_assetId_idx")
  @@index([portfolioId], map: "portfolio_assets_portfolioId_idx")
  @@map("assets")
}

model PortfolioMember {
  id            String    @id(map: "portfolio_members_pkey") @default(uuid())
  portfolioId   String
  accountId     String
  status        String    @default("active")
  isPermanent   Boolean   @default(false)
  hasFullAccess Boolean   @default(false)
  details       Json?
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "portfolio_members_accountId_fkey")
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade, map: "portfolio_members_portfolioId_fkey")

  @@unique([portfolioId, accountId], map: "portfolio_members_portfolioId_accountId_key")
  @@index([accountId], map: "portfolio_members_accountId_idx")
  @@index([portfolioId], map: "portfolio_members_portfolioId_idx")
  @@map("portfolio_member")
}

model Member {
  id                String           @id @default(uuid())
  memberId          String           @map("member_id")
  targetType        MemberTargetType @map("target_type")
  targetAccountId   String?          @map("target_account_id")
  targetPortfolioId String?          @map("target_portfolio_id")
  status            String
  isPermanent       Boolean          @default(false) @map("is_permanent")
  hasFullAccess     Boolean          @default(false) @map("has_full_access")
  details           Json?

  member           Account    @relation("MemberOwner", fields: [memberId], references: [id], onDelete: Cascade, map: "member_member_id_fkey")
  targetAccount     Account?   @relation("MemberTargetAccount", fields: [targetAccountId], references: [id], map: "member_target_account_id_fkey")
  targetPortfolio   Portfolio? @relation("MemberTargetPortfolio", fields: [targetPortfolioId], references: [id], map: "member_target_portfolio_id_fkey")

  @@index([memberId], map: "member_member_id_idx")
  @@index([targetAccountId], map: "member_target_account_id_idx")
  @@index([targetPortfolioId], map: "member_target_portfolio_id_idx")
  @@index([targetType, targetAccountId], map: "member_target_type_target_account_id_idx")
  @@index([targetType, targetPortfolioId], map: "member_target_type_target_portfolio_id_idx")
  @@map("member")
}

model AccountOwnership {
  id         String   @id @default(uuid())
  parentId   String   @map("parent_id")
  childrenId String   @map("children_id")
  type       String
  createdAt  DateTime @default(now()) @map("created_at")

  parent   Account @relation("ParentAccount", fields: [parentId], references: [id], onDelete: Cascade, map: "account_ownership_parent_id_fkey")
  children Account @relation("ChildAccount", fields: [childrenId], references: [id], onDelete: Cascade, map: "account_ownership_children_id_fkey")

  @@index([parentId], map: "account_ownership_parent_id_idx")
  @@index([childrenId], map: "account_ownership_children_id_idx")
  @@map("account_ownership")
}

model ApplicationConnection {
  id          String      @id(map: "user_app_connections_pkey") @default(uuid())
  accountId   String      @map("account_id")
  appId       String      @map("app_id")
  status      String      @default("active")
  connectedAt DateTime    @default(now()) @map("connected_at")
  details     Json?
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "user_app_connections_accountId_fkey")
  application Application @relation(fields: [appId], references: [id], map: "user_app_connections_appId_fkey")

  @@unique([accountId, appId], map: "user_app_connections_accountId_appId_key")
  @@map("application_connection")
}

model ApplicationBridge {
  id          String      @id @default(uuid())
  appId       String      @map("app_id")
  type        String
  value       String
  details     Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  application Application @relation(fields: [appId], references: [id], onDelete: Cascade, map: "application_bridge_appId_fkey")

  @@index([appId, type])
  @@map("application_bridge")
}

model ApplicationPolicy {
  id          String      @id @default(uuid())
  appId       String      @map("app_id")
  policyType  String      @map("policy_type")
  policyValue Json        @map("policy_value")
  createdAt   DateTime    @default(now()) @map("created_at")
  application Application @relation(fields: [appId], references: [id], onDelete: Cascade, map: "application_policies_app_id_fkey")

  @@index([appId, policyType], map: "application_policies_app_id_policy_type_idx")
  @@map("application_policies")
}

/// Status of an authorization grant.
enum AuthzGrantStatus {
  active
  invited
  on_hold
  expired
}

enum MemberTargetType {
  portfolio
  account
}

model AuthzPermission {
  id          String                @id @default(uuid())
  name        String
  description String?
  appId       String?               @map("app_id")
  scope       String?
  application Application?          @relation(fields: [appId], references: [id])
  roleMaps    AuthzRolePermission[]

  @@map("authz_capability")
}

model AuthzRole {
  id           String                    @id @default(uuid())
  name         String
  description  String?
  appId        String?                   @map("app_id")
  scope        String?
  pushed       Boolean                   @default(false)
  application  Application?              @relation(fields: [appId], references: [id])
  roleMaps     AuthzRolePermission[]
  grants       AuthzAccountAccessGrant[]
  assetsGrants AuthzAssetsAccessGrant[]
  appGrants    AuthzAppAccessGrant[]

  @@unique([name, appId], map: "authz_role_name_app_id_key")
  @@map("authz_role")
}

model AuthzRolePermission {
  id                     String          @id @default(uuid())
  roleId                 String          @map("role_id")
  permissionId           String          @map("capability_id")
  scope                  String?
  denormalizedPermission Json?           @map("denormalized_capability")
  appId                  String?         @map("app_id")
  roleName               String?         @map("role_name")
  role                   AuthzRole       @relation(fields: [roleId], references: [id])
  permission             AuthzPermission @relation(fields: [permissionId], references: [id])

  @@map("authz_role_capability")
}

model AuthzAccountAccessGrant {
  id              String           @id @default(uuid())
  ownerAccountId  String           @map("owner_account_id")
  targetAccountId String           @map("target_account_id")
  roleId          String           @map("role_id")
  appId           String           @map("app_id")
  portfolioId     String?          @map("portfolio_id")
  status          AuthzGrantStatus @default(active)

  owner       Account     @relation("AuthzGrantOwner", fields: [ownerAccountId], references: [id])
  target      Account     @relation("AuthzGrantTarget", fields: [targetAccountId], references: [id])
  role        AuthzRole   @relation(fields: [roleId], references: [id], map: "authz_account_access_grant_role_id_fkey")
  application Application @relation(fields: [appId], references: [id], map: "authz_account_access_grant_app_id_fkey")
  portfolio   Portfolio?  @relation(fields: [portfolioId], references: [id], map: "authz_account_access_grant_portfolio_id_fkey")

  @@index([ownerAccountId], map: "authz_account_access_grant_owner_account_id_idx")
  @@index([targetAccountId], map: "authz_account_access_grant_target_account_id_idx")
  @@index([roleId], map: "authz_account_access_grant_role_id_idx")
  @@index([appId], map: "authz_account_access_grant_app_id_idx")
  @@index([status], map: "authz_account_access_grant_status_idx")
  @@map("authz_account_access_grant")
}

model AuthzAssetsAccessGrant {
  id           String  @id @default(uuid())
  asset_id     String  @map("asset_id")
  account_id   String  @map("account_id")
  role_id      String  @map("role_id")
  portfolio_id String? @map("portfolio_id")
  app_id       String  @map("app_id")
  asset_type   String? @map("asset_type")

  asset     Asset      @relation(fields: [asset_id], references: [id], map: "authz_assets_access_grant_asset_id_fkey")
  account   Account    @relation(fields: [account_id], references: [id], map: "authz_assets_access_grant_account_id_fkey")
  role      AuthzRole  @relation(fields: [role_id], references: [id], map: "authz_assets_access_grant_role_id_fkey")
  portfolio Portfolio? @relation(fields: [portfolio_id], references: [id], map: "authz_assets_access_grant_portfolio_id_fkey")

  @@index([asset_id], map: "authz_assets_access_grant_asset_id_idx")
  @@index([account_id], map: "authz_assets_access_grant_account_id_idx")
  @@index([role_id], map: "authz_assets_access_grant_role_id_idx")
  @@index([portfolio_id], map: "authz_assets_access_grant_portfolio_id_idx")
  @@index([app_id], map: "authz_assets_access_grant_app_id_idx")
  @@index([asset_type], map: "authz_assets_access_grant_asset_type_idx")
  @@map("authz_assets_access_grant")
}

model Permit {
  id              String   @id @default(uuid())
  accountId       String   @map("account_id")
  targetAccountId String   @map("target_account_id")
  forSelf         Boolean  @default(false) @map("for_self")
  isRoot          Boolean  @default(false) @map("is_root")
  permissions     String[] @default([])
  restrictions    String[] @default([])
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "permit_account_id_fkey")
  targetAccount Account @relation("PermitTarget", fields: [targetAccountId], references: [id], onDelete: Cascade, map: "permit_target_account_id_fkey")

  @@index([accountId], map: "permit_account_id_idx")
  @@index([targetAccountId], map: "permit_target_account_id_idx")
  @@map("permit")
}

model MemberAccess {
  id         String           @id @default(uuid())
  memberId   String           @map("member_id")
  role       String
  status     AuthzGrantStatus @default(active)
  targetType MemberTargetType @map("target_type")
  targetId   String           @map("target_id")
  action     String

  member Account @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "member_access_member_id_fkey")

  @@index([memberId], map: "member_access_member_id_idx")
  @@index([targetType, targetId], map: "member_access_target_type_target_id_idx")
  @@map("member_access")
}

model AuthzAppAccessGrant {
  id              String           @id @default(uuid())
  appId           String           @map("app_id")
  accountId       String           @map("account_id")
  targetAccountId String           @map("target_account_id")
  roleId          String           @map("role_id")
  portfolioId     String?          @map("portfolio_id")
  status          AuthzGrantStatus @default(active)
  pushed          Boolean          @default(false)

  application   Application @relation(fields: [appId], references: [id], map: "authz_app_access_grant_app_id_fkey")
  account       Account     @relation("AuthzAppGrantOwner", fields: [accountId], references: [id], map: "authz_app_access_grant_account_id_fkey")
  targetAccount Account     @relation("AuthzAppGrantTarget", fields: [targetAccountId], references: [id], map: "authz_app_access_grant_target_account_id_fkey")
  role          AuthzRole   @relation(fields: [roleId], references: [id], map: "authz_app_access_grant_role_id_fkey")
  portfolio     Portfolio?  @relation(fields: [portfolioId], references: [id], map: "authz_app_access_grant_portfolio_id_fkey")

  @@index([appId], map: "authz_app_access_grant_app_id_idx")
  @@index([accountId], map: "authz_app_access_grant_account_id_idx")
  @@index([targetAccountId], map: "authz_app_access_grant_target_account_id_idx")
  @@index([roleId], map: "authz_app_access_grant_role_id_idx")
  @@index([portfolioId], map: "authz_app_access_grant_portfolio_id_idx")
  @@index([status], map: "authz_app_access_grant_status_idx")
  @@map("authz_app_access_grant")
}

/// Stores per-app identity records keyed by guest account ID.
/// trackId holds the guest account ID (from the guest_acc cookie) as the
/// stable device identifier. This is the ssid issued to third-party apps.
model Identity {
  id           String   @id @default(cuid())
  trackId      String   @map("track_id")
  appId        String   @map("app_id")
  originatedOn DateTime @default(now()) @map("originated_on")
  refreshesOn  DateTime @map("refreshes_on")
  validTill    DateTime @map("valid_till")
  details      Json     @default("[]") @map("details")

  application Application @relation(fields: [appId], references: [id])

  @@unique([trackId, appId])
  @@map("identity")
}
