generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id              String   @id(map: "accounts_pkey") @default(uuid())
  displayName     String?
  accountType     String   @default("individual")
  displayImage    String?
  status          String?
  isVerified      Boolean  @default(false)
  details         Json?
  createdAt       DateTime @default(now())
  linkedAccountId String?  @map("linked_account_id")

  brandProfile            AccountTypeBrand?
  individualProfile       AccountTypeIndividual?
  connections             Connection[]
  authMethods             AuthnMethod[]
  sessions                AuthnSession[]
  contacts                Contact[]
  neupIds                 NeupId[]
  notifications           Notification[]
  familyMembers           FamilyMember[]
  verificationActions     Verification[]           @relation("VerificationDoneBy")
  authzAssetsAccessGrants AuthzAssetsAccessGrant[]
  parentAssets            Asset[]                  @relation("AssetParentAccount")
  childAssets             Asset[]                  @relation("AssetChildAccount")
  accessMembers           Member[]                 @relation("MemberChildAccount")
  parentAccountMembers    Member[]                 @relation("MemberParentAccount")
  accessMemberRows        Access[]                 @relation("AccessMemberAccount")
  accessParentRows        Access[]                 @relation("AccessParentAccount")
  accessAssetAccountRows  Access[]                 @relation("AccessAssetAccount")
  denormRoles             Role[]                   @relation("RoleAccount")
  permits                 Permit[]
  permitTargets           Permit[]                 @relation("PermitTarget")
  parentOwnerships        AccountOwnership[]       @relation("ChildAccount")
  childOwnerships         AccountOwnership[]       @relation("ParentAccount")
  linkedAccount           Account?                 @relation("LinkedAccount", fields: [linkedAccountId], references: [id])
  linkedFrom              Account[]                @relation("LinkedAccount")
  resources               Resource[]               @relation("ResourceAccount")
  uploadedResources       Resource[]               @relation("ResourceUploader")

  receivedRequests Request[]      @relation("ReceivedRequests")
  sentRequests     Request[]      @relation("SentRequests")
  errorLogs        SystemError[]
  verifications    Verification[]

  @@map("account")
}

model Resource {
  id         String   @id @default(uuid())
  type       String
  accountId  String?  @map("account_id")
  uploadedBy String   @map("uploaded_by")
  value      String
  details    Json?
  uploadedOn DateTime @default(now()) @map("uploaded_on")

  account  Account? @relation("ResourceAccount", fields: [accountId], references: [id], onDelete: SetNull)
  uploader Account  @relation("ResourceUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([type], map: "resources_type_idx")
  @@index([accountId], map: "resources_account_id_idx")
  @@index([uploadedBy], map: "resources_uploaded_by_idx")
  @@index([uploadedOn], map: "resources_uploaded_on_idx")
  @@map("resources")
}

model AccountTypeIndividual {
  accountId          String    @id @unique(map: "account_type__individual_accountId_key")
  firstName          String?
  middleName         String?
  lastName           String?
  dateOfBirth        DateTime?
  countryOfResidence String?
  details            Json?
  roleId             String?   @map("roleId")
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "account_type__individual_accountId_fkey")

  @@map("account_individual")
}

model AccountTypeBrand {
  accountId     String  @id @unique(map: "account_type__brand_accountId_key")
  brandName     String?
  isLegalEntity Boolean @default(false)
  originCountry String?
  details       Json?
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "account_type__brand_accountId_fkey")

  @@map("account_brand")
}

model SystemConfig {
  key       String   @id
  data      Json
  updatedAt DateTime @default(now()) @updatedAt

  @@map("system_config")
}

model AuthnRequest {
  id        String   @id(map: "auth_requests_pkey") @default(uuid())
  type      String
  status    String   @default("pending")
  data      Json     @default("{}")
  accountId String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("authn_request")
}

model Activity {
  id             String   @id(map: "activity_logs_pkey") @default(uuid())
  memberId       String   @map("target_account_id")
  actorAccountId String   @map("actor_account_id")
  action         String
  status         String
  ip             String
  timestamp      DateTime @default(now())
  geolocation    String?

  @@map("activity")
}

model Notification {
  id          String    @id(map: "notifications_pkey") @default(uuid())
  accountId   String    @map("account_id")
  action      String?
  title       String?
  message     String?
  type        String    @default("info")
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  deletableOn DateTime? @map("deletable_on")
  persistence String?
  detail      Json?
  account     Account   @relation(fields: [accountId], references: [id], map: "notifications_accountId_fkey")

  @@map("notification")
}

model Request {
  id          String   @id(map: "requests_pkey") @default(uuid())
  senderId    String
  recipientId String   @map("recipient_id")
  status      String   @default("pending")
  action      String
  type        String?
  data        Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  recipient   Account  @relation("ReceivedRequests", fields: [recipientId], references: [id], map: "requests_recipientId_fkey")
  sender      Account  @relation("SentRequests", fields: [senderId], references: [id], map: "requests_senderId_fkey")

  @@map("request")
}

model Family {
  id        String         @id @default(uuid())
  createdBy String         @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  members   FamilyMember[]

  @@map("family")
}

model FamilyMember {
  id       String @id @default(uuid())
  familyId String @map("family_id")
  memberId String @map("member_id")
  role     String @default("member")

  family Family  @relation(fields: [familyId], references: [id], map: "family_member_family_id_fkey")
  member Account @relation(fields: [memberId], references: [id], map: "family_member_member_id_fkey")

  @@unique([familyId, memberId], map: "family_member_family_member_key")
  @@map("family_member")
}

model Verification {
  id         String   @id(map: "verification_pkey") @default(uuid())
  accountId  String   @map("account_id")
  status     String   @default("pending")
  reason     String?
  category   String?
  doneBy     String?  @map("done_by")
  doneAt     DateTime @default(now()) @map("done_at")
  previously String?
  createdAt  DateTime @default(now()) @map("created_at")

  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "verification_account_id_fkey")
  doneByAccount Account? @relation("VerificationDoneBy", fields: [doneBy], references: [id], map: "verification_done_by_fkey")

  @@map("verification")
}

model Contact {
  id          String  @id(map: "contacts_pkey") @default(uuid())
  accountId   String
  contactType String
  value       String
  account     Account @relation(fields: [accountId], references: [id], map: "contacts_accountId_fkey")

  @@map("contact")
}

model NeupId {
  id        String   @id(map: "neup_ids_pkey")
  accountId String
  neupId    String   @unique(map: "neupid_neupid_key") @map("neupId")
  isPrimary Boolean  @default(false)
  dateAdded DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], map: "neup_ids_accountId_fkey")

  @@map("neupid")
}

model AuthnMethod {
  accountId String
  value     String
  id        String  @id @default(uuid())
  type      String
  order     String
  status    String
  detail    Json?
  account   Account @relation(fields: [accountId], references: [id], map: "passwords_accountId_fkey")

  @@unique([accountId, type, order])
  @@index([accountId])
  @@map("authn_method")
}

model AuthnSession {
  id           String    @id(map: "sessions_pkey") @default(uuid())
  accountId    String
  key          String?
  ipAddress    String
  userAgent    String
  validTill    DateTime?
  lastLoggedIn DateTime
  loginType    String
  geolocation  String?
  deviceType   String?
  account      Account   @relation(fields: [accountId], references: [id], map: "sessions_accountId_fkey")

  @@map("authn_session")
}

model SystemError {
  id          String   @id(map: "error_logs_pkey") @default(uuid())
  message     String
  context     String
  timestamp   DateTime @default(now())
  accountId   String?
  geolocation String?
  ipAddress   String?
  account     Account? @relation(fields: [accountId], references: [id], map: "error_logs_accountId_fkey")

  @@map("system_error")
}

model ApplicationProvider {
  id           String        @id @default(uuid())
  providerName String        @map("provider_name")
  providerSite String        @map("provider_site")
  secretHash   String        @map("secret_hash")
  applications Application[]

  @@map("application_provider")
}

model Application {
  id               String               @id(map: "applications_pkey")
  name             String
  description      String?
  icon             String?
  website          String?
  appSecret        String?              @map("app_secret")
  createdAt        DateTime             @default(now()) @map("created_at")
  endpoints        Json?
  status           String               @default("development")
  isInternal       Boolean              @default(false) @map("is_internal")
  responseFields   String[]             @default([]) @map("response_fields")
  tokenFields      String[]             @default([]) @map("token_fields")
  details          Json?
  party            Int                  @default(1)
  providerId       String?              @map("provider_id")
  defaultRoleId    String?              @map("def_role_id")
  provider         ApplicationProvider? @relation(fields: [providerId], references: [id], map: "application_provider_id_fkey")
  defaultRole      AuthzRole?           @relation("ApplicationDefaultRole", fields: [defaultRoleId], references: [id], map: "application_def_role_id_fkey")
  connections      Connection[]
  bridge           ApplicationBridge[]
  policies         ApplicationPolicy[]
  authzPermissions AuthzPermission[]
  authzRoles       AuthzRole[]
  identities       Identity[]
  childAssets      Asset[]              @relation("AssetChildApplication")
  assetAccessRows  Access[]             @relation("AccessAssetApplication")
  accessRows       Access[]             @relation("AccessApplication")
  devLogs          ApplicationDevLog[]

  @@map("application")
}

model ApplicationDevLog {
  id           String      @id @default(uuid())
  appId        String      @map("app_id")
  endpoint     String
  method       String
  statusCode   Int         @map("status_code")
  requesterIp  String?     @map("requester_ip")
  origin       String?
  referer      String?
  userAgent    String?     @map("user_agent")
  requestBody  Json?       @map("request_body")
  query        Json?
  requestMeta  Json?       @map("request_meta")
  responseBody Json?       @map("response_body")
  error        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  application  Application @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt], map: "application_dev_log_app_id_created_at_idx")
  @@index([createdAt], map: "application_dev_log_created_at_idx")
  @@map("application_dev_log")
}

model Asset {
  id                      String                   @id(map: "portfolio_assets_pkey") @default(uuid())
  access_type             AssetType                @map("type")
  member_account_id       String?                  @map("child_account_id")
  member_connection_id    String?                  @map("child_connection_id")
  access_application_id   String?                  @map("child_application_id")
  parent_account_id       String?                  @map("parent_account_id")
  isTemporary             DateTime?                @map("is_temporary")
  status                  String                   @default("active")
  details                 Json?
  parentAccount           Account?                 @relation("AssetParentAccount", fields: [parent_account_id], references: [id], onDelete: Cascade, map: "assets_parent_account_id_fkey")
  childAccount            Account?                 @relation("AssetChildAccount", fields: [member_account_id], references: [id], onDelete: Cascade, map: "assets_child_account_id_fkey")
  childConnection         Connection?              @relation("AssetChildConnection", fields: [member_connection_id], references: [id], onDelete: Cascade, map: "assets_child_connection_id_fkey")
  childApplication        Application?             @relation("AssetChildApplication", fields: [access_application_id], references: [id], onDelete: Cascade, map: "assets_child_application_id_fkey")
  accessRows              Access[]
  roles                   Role[]
  authzAssetsAccessGrants AuthzAssetsAccessGrant[]

  @@index([access_type, member_account_id], map: "assets_type_child_account_id_idx")
  @@index([access_type, access_application_id], map: "assets_type_child_application_id_idx")
  @@index([access_type, member_connection_id], map: "assets_type_child_connection_id_idx")
  @@index([parent_account_id], map: "assets_parent_account_id_idx")
  @@index([isTemporary], map: "assets_is_temporary_idx")
  @@map("assets")
}

model Member {
  id              String    @id @default(uuid())
  memberType      String    @map("member_type")
  memberAccountId String?   @map("child_account_id")
  parentAccountId String?   @map("parent_account_id")
  status          String    @default("active")
  isTemporary     DateTime? @map("is_temporary")
  details         Json?

  memberAccount Account? @relation("MemberChildAccount", fields: [memberAccountId], references: [id], onDelete: Cascade, map: "member_child_account_id_fkey")
  parentAccount Account? @relation("MemberParentAccount", fields: [parentAccountId], references: [id], onDelete: Cascade, map: "member_parent_account_id_fkey")
  accessRows    Access[]
  roles         Role[]

  @@index([memberType], map: "member_member_type_idx")
  @@index([memberAccountId], map: "member_child_account_id_idx")
  @@index([parentAccountId], map: "member_parent_account_id_idx")
  @@index([isTemporary], map: "member_is_temporary_idx")
  @@map("member")
}

model Access {
  id                  String     @id @default(uuid())
  accessType          AccessType @map("access_type")
  memberId            String     @map("member_id")
  memberAccountId     String?    @map("member_account_id")
  parentAccountId     String?    @map("parent_account_id")
  assetId             String     @map("asset_id")
  assetAccountId      String?    @map("asset_account_id")
  assetConnectionId   String?    @map("asset_connection_id")
  assetApplicationId  String?    @map("asset_application_id")
  accessApplicationId String?    @map("access_application_id")
  isTemporary         DateTime?  @map("is_temporary")
  roleId              String     @map("role_id")
  status              String     @default("active")
  details             Json?

  member            Member       @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "access_member_id_fkey")
  memberAccount     Account?     @relation("AccessMemberAccount", fields: [memberAccountId], references: [id], onDelete: Cascade, map: "access_member_account_id_fkey")
  parentAccount     Account?     @relation("AccessParentAccount", fields: [parentAccountId], references: [id], onDelete: Cascade, map: "access_parent_account_id_fkey")
  asset             Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade, map: "access_asset_id_fkey")
  assetAccount      Account?     @relation("AccessAssetAccount", fields: [assetAccountId], references: [id], onDelete: Cascade, map: "access_asset_account_id_fkey")
  assetConnection   Connection?  @relation("AccessAssetConnection", fields: [assetConnectionId], references: [id], onDelete: Cascade, map: "access_asset_connection_id_fkey")
  assetApplication  Application? @relation("AccessAssetApplication", fields: [assetApplicationId], references: [id], onDelete: Cascade, map: "access_asset_application_id_fkey")
  accessApplication Application? @relation("AccessApplication", fields: [accessApplicationId], references: [id], onDelete: SetNull, map: "access_access_application_id_fkey")
  role              AuthzRole    @relation(fields: [roleId], references: [id], map: "access_role_id_fkey")

  @@index([accessType], map: "access_access_type_idx")
  @@index([memberId], map: "access_member_id_idx")
  @@index([memberAccountId], map: "access_member_account_id_idx")
  @@index([parentAccountId], map: "access_parent_account_id_idx")
  @@index([assetId], map: "access_asset_id_idx")
  @@index([assetAccountId], map: "access_asset_account_id_idx")
  @@index([assetConnectionId], map: "access_asset_connection_id_idx")
  @@index([assetApplicationId], map: "access_asset_application_id_idx")
  @@index([accessApplicationId], map: "access_access_application_id_idx")
  @@index([roleId], map: "access_role_id_idx")
  @@index([status], map: "access_status_idx")
  @@index([isTemporary], map: "access_is_temporary_idx")
  @@map("access")
}

model AccountOwnership {
  id         String   @id @default(uuid())
  parentId   String   @map("parent_id")
  childrenId String   @map("children_id")
  type       String
  createdAt  DateTime @default(now()) @map("created_at")

  parent   Account @relation("ParentAccount", fields: [parentId], references: [id], onDelete: Cascade, map: "account_ownership_parent_id_fkey")
  children Account @relation("ChildAccount", fields: [childrenId], references: [id], onDelete: Cascade, map: "account_ownership_children_id_fkey")

  @@index([parentId], map: "account_ownership_parent_id_idx")
  @@index([childrenId], map: "account_ownership_children_id_idx")
  @@map("account_ownership")
}

model Connection {
  id              String      @id(map: "user_app_connections_pkey") @default(uuid())
  accountId       String      @map("account_id")
  appId           String      @map("app_id")
  roleId          String?     @map("role_id")
  status          String      @default("active")
  connectedAt     DateTime    @default(now()) @map("connected_at")
  details         Json?
  account         Account     @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "user_app_connections_accountId_fkey")
  application     Application @relation(fields: [appId], references: [id], map: "user_app_connections_appId_fkey")
  role            AuthzRole?  @relation("ConnectionRole", fields: [roleId], references: [id], map: "connection_role_id_fkey")
  childAssets     Asset[]     @relation("AssetChildConnection")
  assetAccessRows Access[]    @relation("AccessAssetConnection")
  denormRoles     Role[]      @relation("RoleConnection")

  @@unique([accountId, appId], map: "user_app_connections_accountId_appId_key")
  @@map("connection")
}

model ApplicationBridge {
  id          String      @id @default(uuid())
  appId       String      @map("app_id")
  type        String
  value       String
  details     Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  application Application @relation(fields: [appId], references: [id], onDelete: Cascade, map: "application_bridge_appId_fkey")

  @@index([appId, type])
  @@map("application_bridge")
}

model ApplicationPolicy {
  id          String      @id @default(uuid())
  appId       String      @map("app_id")
  policyType  String      @map("policy_type")
  policyValue Json        @map("policy_value")
  createdAt   DateTime    @default(now()) @map("created_at")
  application Application @relation(fields: [appId], references: [id], onDelete: Cascade, map: "application_policies_app_id_fkey")

  @@index([appId, policyType], map: "application_policies_app_id_policy_type_idx")
  @@map("application_policies")
}

/// Status of an authorization grant.
enum AuthzGrantStatus {
  active
  invited
  on_hold
  expired
}

enum AssetType {
  acc_in_acc
  app_in_acc
  conn_in_acc

  @@map("asset_type")
}

enum AccessType {
  acc_self
  acc_self_root @map("acc_self.root")
  acc_in_acc
  app_in_acc
  conn_in_acc

  @@map("access_type")
}

enum MemberAccessFor {
  account
  application
  connection
}

enum MemberStatus {
  active
  paused
  removed
}

model Role {
  id            String  @id @default(uuid())
  memberId      String  @map("member_id")
  accountId     String? @map("account_id")
  connectionId  String? @map("connection_id")
  assetId       String? @map("asset_id")
  assetType     String? @map("asset_type")
  assetIdDenorm String? @map("asset_id_denorm")
  roleId        String  @map("role_id")
  roleName      String? @map("role_name")
  permissions   Json?
  status        String  @default("active")
  details       Json?

  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "role_member_id_fkey")
  account    Account?    @relation("RoleAccount", fields: [accountId], references: [id], map: "role_account_id_fkey")
  connection Connection? @relation("RoleConnection", fields: [connectionId], references: [id], map: "role_connection_id_fkey")
  asset      Asset?      @relation(fields: [assetId], references: [id], map: "role_asset_id_fkey")
  authzRole  AuthzRole   @relation(fields: [roleId], references: [id], map: "role_role_id_fkey")

  @@index([memberId], map: "role_member_id_idx")
  @@index([accountId], map: "role_account_id_idx")
  @@index([connectionId], map: "role_connection_id_idx")
  @@index([assetId], map: "role_asset_id_idx")
  @@index([assetType], map: "role_asset_type_idx")
  @@index([roleId], map: "role_role_id_idx")
  @@map("role")
}

/**
 * ::neup.documentation::authz-permission-model
 * ::title Authz Permission Model
 * Stores application permission metadata and scope-policy fields.
 * ::public
 * Permissions belong to one application and persist their `scope_for` / `scope_level` policy together with optional descriptive metadata.
 * ::public end
 * ::private
 * The legacy permission `scope` column has been removed. Runtime compatibility now derives any needed legacy semantics from `scope_for`, `scope_level`, `acquisition_type`, and `approval_policy`.
 * ::private end
 * ::end
 */
model AuthzPermission {
  id              String                   @id @default(uuid())
  name            String
  description     String?
  appId           String?                  @map("app_id")
  scopeFor        Json?                    @default("[]") @map("scope_for")
  scopeLevel      Json?                    @default("[]") @map("scope_level")
  acquisitionType String?                  @default("assignment") @map("acquisition_type")
  approvalPolicy  String?                  @default("none") @map("approval_policy")
  rules           String?
  status          String?
  tag             Json?
  application     Application?             @relation(fields: [appId], references: [id])
  roleMappings    AuthzRolePermissionMap[]

  @@unique([name, appId], map: "authz_permission_name_app_id_key")
  @@map("authz_permission")
}

model AuthzRole {
  id                     String                   @id @default(uuid())
  name                   String
  description            String?
  appId                  String?                  @map("app_id")
  scopeFor               Json                     @default("[]") @map("scope_for")
  scopeLevel             String                   @default("assignable") @map("scope_level")
  acquisitionType        String                   @default("assignment") @map("acquisition_type")
  approvalPolicy         String                   @default("none") @map("approval_policy")
  pushed                 Boolean                  @default(false)
  applicableFor          Json                     @default("[]") @map("applicable_for")
  permissions            Json?
  application            Application?             @relation(fields: [appId], references: [id])
  assetsGrants           AuthzAssetsAccessGrant[]
  accessRows             Access[]
  permissionMappings     AuthzRolePermissionMap[]
  memberRoles            Role[]
  connections            Connection[]             @relation("ConnectionRole")
  defaultForApplications Application[]            @relation("ApplicationDefaultRole")

  @@unique([name, appId], map: "authz_role_name_app_id_key")
  @@map("authz_role")
}

model AuthzRolePermissionMap {
  id           String          @id @default(uuid())
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  scopeFor     String          @map("scope_for")
  scopeLevel   String          @map("scope_level")
  createdAt    DateTime        @default(now()) @map("created_at")
  role         AuthzRole       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "authz_role_permission_map_role_id_fkey")
  permission   AuthzPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "authz_role_permission_map_permission_id_fkey")

  @@unique([roleId, permissionId, scopeFor, scopeLevel], map: "authz_role_permission_map_role_permission_scope_key")
  @@index([roleId], map: "authz_role_permission_map_role_id_idx")
  @@index([permissionId], map: "authz_role_permission_map_permission_id_idx")
  @@map("authz_role_permission_map")
}

model AuthzAssetsAccessGrant {
  id         String  @id @default(uuid())
  asset_id   String  @map("asset_id")
  account_id String  @map("account_id")
  role_id    String  @map("role_id")
  app_id     String  @map("app_id")
  asset_type String? @map("asset_type")

  asset   Asset     @relation(fields: [asset_id], references: [id], map: "authz_assets_access_grant_asset_id_fkey")
  account Account   @relation(fields: [account_id], references: [id], map: "authz_assets_access_grant_account_id_fkey")
  role    AuthzRole @relation(fields: [role_id], references: [id], map: "authz_assets_access_grant_role_id_fkey")

  @@index([asset_id], map: "authz_assets_access_grant_asset_id_idx")
  @@index([account_id], map: "authz_assets_access_grant_account_id_idx")
  @@index([role_id], map: "authz_assets_access_grant_role_id_idx")
  @@index([app_id], map: "authz_assets_access_grant_app_id_idx")
  @@index([asset_type], map: "authz_assets_access_grant_asset_type_idx")
  @@map("authz_assets_access_grant")
}

model Permit {
  id           String   @id @default(uuid())
  accountId    String   @map("account_id")
  memberId     String   @map("target_account_id")
  forSelf      Boolean  @default(false) @map("for_self")
  isRoot       Boolean  @default(false) @map("is_root")
  permissions  String[] @default([])
  restrictions String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "permit_account_id_fkey")
  targetAccount Account @relation("PermitTarget", fields: [memberId], references: [id], onDelete: Cascade, map: "permit_target_account_id_fkey")

  @@index([accountId], map: "permit_account_id_idx")
  @@index([memberId], map: "permit_target_account_id_idx")
  @@map("permit")
}

/// Stores per-app identity records keyed by guest account ID.
/// trackId holds the guest account ID (from the guest_acc cookie) as the
/// stable device identifier. This is the ssid issued to third-party apps.
model Identity {
  id           String   @id @default(cuid())
  trackId      String   @map("track_id")
  appId        String   @map("app_id")
  originatedOn DateTime @default(now()) @map("originated_on")
  refreshesOn  DateTime @map("refreshes_on")
  validTill    DateTime @map("valid_till")
  details      Json     @default("[]") @map("details")

  application Application @relation(fields: [appId], references: [id])

  @@unique([trackId, appId])
  @@map("identity")
}
